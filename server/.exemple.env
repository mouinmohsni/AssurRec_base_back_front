# API autonome : aucune dépendance à client/.env ni au package racine.
PORT=4000
NODE_ENV=development
DATABASE_URL=mysql://*****:*****@localhost:3306/assurrec
# À activer pour MySQL distant TLS ; TiDB Cloud active TLS automatiquement.
DB_TLS=false
DB_CONNECTION_LIMIT=10
# HTTP local seulement ; pour HTTPS/Preview choisir https-preview.
COOKIE_MODE=local-http
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_ENABLED=true
DEMO_PASSWORD=AssurRec-Demo-2026!
# Production uniquement : chemin ABSOLU vers le client déjà compilé ; vide = API seule.
FRONTEND_DIST=
