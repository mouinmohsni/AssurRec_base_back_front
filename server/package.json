{
  "name": "assurrec-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node scripts/start.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "check": "node scripts/check.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.1.0",
    "mysql2": "3.24.6",
    "sequelize": "6.37.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "jest": "^30.5.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
