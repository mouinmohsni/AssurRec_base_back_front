# Développement : Vite écoute sur 3000 et transmet /api à Express 4000.
API_PROXY_TARGET=http://127.0.0.1:4000

# Vide = requêtes relatives /api (local via proxy ou production même origine).
# Si l'API est déployée ailleurs : origine HTTPS sans /api ni slash final.
# Exemple : VITE_API_BASE_URL=https://api.exemple.tn
# Toutes les variables VITE_* sont publiques : jamais de mot de passe ou DATABASE_URL.
VITE_API_BASE_URL=

# Facultatif : noms d'hôtes EXACTS pour un aperçu distant Vite, séparés par virgules.
PREVIEW_ALLOWED_HOSTS=
